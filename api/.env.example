# PostgreSQL is required for readiness checks, migrations, and worker execution.
DATABASE_URL=postgresql+psycopg://numa:change-me@localhost:5432/numa

# Reconciliation blocks non-zero discrepancies by default. Tolerance is an
# exact count of the selected Account currency's smallest unit.
RECONCILIATION_POLICY=block
RECONCILIATION_TOLERANCE_ATOMS=0

# Optional provider configuration. Leave these variables empty to disable them.
AI_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Authorized callback URL registered with Google (same public origin as the web app).
GMAIL_REDIRECT_URI=
# Fernet key generated once, retained securely on the server across restarts.
GMAIL_TOKEN_KEY=
GMAIL_POLL_SECONDS=300
# Required explicit scope for ingestion; JSON array of exact addresses, never domains/wildcards.
# Example: ["do-not-reply@ses.binance.com","notificaciones@bg.com.bo"]
GMAIL_ALLOWED_SENDERS=[]
EXCHANGE_API_KEY=
